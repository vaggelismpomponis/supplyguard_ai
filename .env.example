# ==============================================================================
# SupplyGuard AI - Environment Variables Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env':
#      PowerShell: Copy-Item .env.example .env
#      Bash:       cp .env.example .env
#      CMD:        copy .env.example .env
# 2. Fill in your real API keys and credentials in '.env'.
# 3. DO NOT commit the '.env' file into version control (ignored via .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL + pgvector (Checkpointer, Audit Log, Structured Data, Semantic Search)
# Matches service configuration in docker-compose.yml
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=supplyguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/supplyguard

# ------------------------------------------------------------------------------
# Neo4j Graph Database (Multi-tier Suppliers, Components, Products, Factories)
# Browser UI available at: http://localhost:7474
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ------------------------------------------------------------------------------
# ChromaDB Vector Store (Vector Benchmark & Secondary Corpus Index)
# Available at: http://localhost:8001
# ------------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_SERVER_HOST=chromadb
CHROMA_SERVER_HTTP_PORT=8000

# ------------------------------------------------------------------------------
# External Risk & Disruption Feed Service
# Available at: http://localhost:8080/alerts
# ------------------------------------------------------------------------------
EXTERNAL_RISK_URL=http://external-risk:8080
EXTERNAL_RISK_PORT=8080

# ------------------------------------------------------------------------------
# Simulated Procurement MCP Protocol Configuration
# ------------------------------------------------------------------------------
MCP_SERVER_ENABLED=true
MCP_PROCUREMENT_PORT=8085

# ------------------------------------------------------------------------------
# Chainlit Authentication & Role-Scoped Operator Accounts
# Generate CHAINLIT_AUTH_SECRET via: chainlit create-secret
# In development/demo, AUTH_DEMO_DEFAULT_PASSWORD seeds initial users from users.csv
# ------------------------------------------------------------------------------
CHAINLIT_AUTH_SECRET=replace_with_random_chainlit_auth_secret
AUTH_DEMO_DEFAULT_PASSWORD=replace_with_dev_demo_password

# ------------------------------------------------------------------------------
# Azure OpenAI (Primary LLM & Embedding Models)
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

AZURE_EMBEDDING_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_EMBEDDING_API_KEY=your_azure_embedding_api_key_here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ------------------------------------------------------------------------------
# OpenAI / Anthropic Fallback & Offline Mode (Optional, if not using Azure OpenAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-4o-mini
OFFLINE_MODE=false

# ------------------------------------------------------------------------------
# LangSmith Observability, Tracing & Evaluation Suite
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=supplyguard-ai
