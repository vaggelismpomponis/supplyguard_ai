MERGE (o:Outage {outage_id:'OUT-001'}) SET o.title='Identity Provider degraded: SSO and MFA logins failing intermittently', o.status='open', o.severity='major', o.started_at=datetime('2026-11-12T13:40:00Z'), o.symptoms='Login failures, SSO errors, MFA prompts not arriving, VPN authentication failures. Password resets do not resolve it.', o.affected_offices='Both offices', o.latest_update='Vendor engaged, next update 2026-11-13 16:00 UTC' WITH o MATCH (s:Service {service_id:'S01'}) MERGE (o)-[:AFFECTS]->(s);
MERGE (o:Outage {outage_id:'OUT-002'}) SET o.title='Athens print servers unavailable', o.status='open', o.severity='minor', o.started_at=datetime('2026-11-13T07:15:00Z'), o.symptoms='Print jobs stuck in queue or Print Manager unreachable.', o.affected_offices='Athens', o.latest_update='Spare server being provisioned, ETA 2026-11-13 18:00 UTC' WITH o MATCH (s:Service {service_id:'S07'}) MERGE (o)-[:AFFECTS]->(s);

// Example: open outages explaining an application (follows dependencies transitively)
// MATCH (a:Application {name:'Corporate VPN'})-[:DEPENDS_ON*1..3]->(s:Service)<-[:AFFECTS]-(o:Outage {status:'open'}) RETURN DISTINCT o.outage_id, o.title;
// Example: teams affected by an outage
// MATCH (o:Outage {outage_id:'OUT-001'})-[:AFFECTS]->(s:Service)<-[:DEPENDS_ON*1..3]-(a:Application)<-[:USES]-(t:Team) RETURN DISTINCT t.name;
